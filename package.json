{
  "name": "bricks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsc -p tsconfig.tests.json && node --test tests/*.test.ts",
    "preview": "vite preview",
    "test:browser": "node --test tests/browser.integration.mjs",
    "emulators": "node scripts/firebase-emulators.mjs",
    "test:firebase": "node scripts/firebase-emulators.mjs --test",
    "test:firebase:auth": "node scripts/firebase-emulators.mjs --auth-only"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.34.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
