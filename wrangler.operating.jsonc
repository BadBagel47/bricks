{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bricks-operating",
  "main": "server/operating/worker.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "bricks-operating", "database_id": "665b9d70-e43f-47f3-a15b-875abfb256a5" }],
  "triggers": { "crons": ["17 3,15 * * *"] },
  "observability": { "enabled": false },
  "vars": {
    "PROJECT": "bricks",
    "ADMIN_ORIGIN": "https://bricks-operating.l8p1.workers.dev",
    "GAME_URL": "https://bricks.trythis.one/",
    "FIREBASE_PROJECT_ID": "bricks-8f56b",
    "FIREBASE_DATABASE_ORIGIN": "https://bricks-8f56b-default-rtdb.europe-west1.firebasedatabase.app",
    "DAILY_MAIL_LIMIT": "90",
    "MAIL_FROM": "system@trythis.one"
  }
}
