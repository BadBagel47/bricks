# Public Firebase Web App configuration, not an Admin SDK credential.
# Copy to .env.local only after creating a Spark project, enabling Anonymous
# Authentication and deploying the reviewed Realtime Database rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_USE_EMULATORS=false
