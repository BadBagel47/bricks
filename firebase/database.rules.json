{
  "rules": {
    ".read": false,
    ".write": false,
    "roomReservations": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-HJ-NP-Z2-9]{6,8}$/)",
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z2-9]{6,8}$/) && !data.exists() && newData.exists() && newData.child('ownerUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['version', 'ownerUid', 'createdAt'])",
        "version": { ".validate": "newData.isNumber() && newData.val() === 1" },
        "ownerUid": { ".validate": "newData.isString() && newData.val() === auth.uid && newData.val().length <= 128" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
